# Copie ce fichier en .env.local et renseigne chaque valeur. Aucun secret n'est commité (N-04).

# Base Postgres (Supabase, région eu-central-1) : chaîne du pooler (port 6543) pour l'app,
# chaîne directe (port 5432) pour les migrations.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Stockage de fichiers Supabase (bucket privé, voir README)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cards-media

# Accès : adresses admin (virgules) et domaines autorisés pour les membres
ADMIN_EMAILS=laurent.fontaine@ascenzia.fr
ALLOWED_EMAIL_DOMAINS=ascenzia.fr,ascenzia.ai

# Auth.js
AUTH_SECRET=
AUTH_TRUST_HOST=true

# E-mail transactionnel (Resend, domaine d'envoi vérifié)
RESEND_API_KEY=
MAIL_FROM="Ascenzia Cards <cards@ascenzia.ai>"

# Apple Wallet (section 6 du cahier des charges). PEM encodés en base64.
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.ai.ascenzia.cards
APPLE_PASS_CERT_B64=
APPLE_PASS_KEY_B64=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_B64=

# URL publique
PUBLIC_BASE_URL=https://cards.ascenzia.ai

# Sel du hachage d'IP pour le compteur de vues (N-09)
IP_HASH_SALT=

# Jeton de la route de purge (lot 2)
CRON_SECRET=

# Développement local uniquement : stockage des médias sur disque au lieu de Supabase (refusé sur Vercel)
# LOCAL_STORAGE_DIR=.local-storage
